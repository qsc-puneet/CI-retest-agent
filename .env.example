# ─── .env Template ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# See .env.example comments for provider-specific instructions.
# ────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=
OPENAI_BASE_URL=
# LLM_MODEL is required. Set to the exact Ollama tag on your server.
# Examples:
#   llama3.1:8b-instruct-q4_K_M   (Meta, ~5 GB, recommended)
#   gemma2:9b-instruct-q4_K_M     (Google, ~5.5 GB, verbose prose)
#   mistral-nemo:12b-instruct-q4_K_M (Mistral, ~7 GB, stronger reasoning)
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
MAX_PARALLEL_AGENTS=1
OUTPUT_JSON_PATH=decision_hub_output.json
LOG_FILE_PATH=decision-hub.log

# ─── Qsys Analyzer (MSSQL) ─────────────────────────────────────────────────
MSSQL_HOST=1inbgsqadbp02
MSSQL_PORT=1433
MSSQL_USER=sqauser
MSSQL_PASSWORD=sqasql#1
MSSQL_DATABASE=QE_QAT_Server_Runner
